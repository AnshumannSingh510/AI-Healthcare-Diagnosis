# ==============================================
# AI Healthcare Diagnosis Platform — environment configuration
# Copy this file to .env and fill in real values before running
# `docker-compose up`.
# ==============================================

# --- Database ---
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/healthcare_ai

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Auth ---
# Generate a strong random secret for production, e.g.: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- Storage ---
UPLOAD_DIR=/app/storage/uploads
HEATMAP_DIR=/app/storage/heatmaps
REPORT_DIR=/app/storage/reports

# --- AI Model ---
MODEL_WEIGHTS_PATH=/app/model_weights/densenet121_chest.pt
MODEL_BACKBONE=densenet121
MODEL_IMAGE_SIZE=224

# --- LLM (chatbot + plain-language explanations) ---
# LLM_PROVIDER: "anthropic" | "openai" | "none"
# If "none" (or no key set), the app falls back to deterministic template
# responses so it still runs without any LLM API key.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# --- CORS (comma-separated list consumed by pydantic-settings as JSON array in code;
#     when overriding via .env, prefer editing app/core/config.py directly) ---
# CORS_ORIGINS=["http://localhost:3000"]

ENV=development
